# Contact form — envoi de mail via Resend (https://resend.com)
# 1. Crée un compte gratuit Resend
# 2. Ajoute ta clé API (Dashboard → API Keys)
# 3. Optionnel mais recommandé : vérifie ton domaine (Settings → Domains)
#    puis mets CONTACT_FROM_EMAIL = contact@ton-domaine.fr
# Sans domaine vérifié, l'envoi se fait depuis onboarding@resend.dev
# (limité aux mails vers ton propre compte, parfait pour tester).
RESEND_API_KEY=
CONTACT_FROM_EMAIL=onboarding@resend.dev
